# Cloudflare R2 credentials, used only by `uv run mbv publish`.
# Dashboard → R2 → Manage API tokens → Create API token (Object Read & Write, scoped to the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mailboxes

# Public base URL of the bucket: the r2.dev URL (Settings → Public access → R2.dev subdomain)
# or your custom domain. The viewer's VITE_DATA_URL must be set to the same value.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Optional: any other S3-compatible endpoint (MinIO, Garage, ...) instead of R2.
# S3_ENDPOINT_URL=http://localhost:9000
